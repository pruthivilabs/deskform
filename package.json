{
  "name": "deskform",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "turbo run check:repo typecheck typecheck:repo",
    "check:repo": "vp check",
    "typecheck:repo": "tsrs --noEmit --fast -p tsconfig.json",
    "format": "vp fmt",
    "dev": "turbo run dev:fixture",
    "build": "turbo run build:fixture",
    "test:native": "turbo run test:native test:integration --concurrency=1",
    "test": "turbo run test",
    "dev:tools": "turbo run dev:workshop",
    "test:production": "turbo run test:compiled --concurrency=1",
    "test:devtools": "turbo run test:workshop --concurrency=1",
    "dev:fixture": "deskform dev tests/fixtures/entry.tsx",
    "build:fixture": "deskform build tests/fixtures/entry.tsx --outfile output/deskform-fixture",
    "test:integration": "bun test tests/native/*.native.test.tsx",
    "dev:workshop": "deskform devtools",
    "test:compiled": "bun test tests/native/production.test.tsx",
    "test:workshop": "playwright test --config tests/workshop/playwright.config.ts",
    "test:devtools:install": "playwright install chromium --no-shell",
    "pack": "turbo run pack",
    "test:consumer": "turbo run test:consumer:fixture --concurrency=1",
    "test:consumer:fixture": "bun test tests/native/consumer.test.tsx"
  },
  "devDependencies": {
    "@deskform/runtime": "workspace:*",
    "@deskform/tokens": "workspace:*",
    "@deskform/tooling": "workspace:*",
    "@deskform/ui": "workspace:*",
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "react": "19.2.9",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "turbo": "2.11.10",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "@gpuix/native": "0.11.0"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.3"
}
