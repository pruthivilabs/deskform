{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "vite.config.ts"],
  "tasks": {
    "//#check:repo": {
      "outputs": []
    },
    "//#typecheck:repo": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DESKFORM_DATA_DIR"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "test:native": {
      "cache": false,
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "dev:tools": {
      "cache": false,
      "persistent": true
    },
    "test:production": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "test:devtools": {
      "cache": false,
      "outputs": []
    }
  }
}
