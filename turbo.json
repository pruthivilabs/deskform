{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "vite.config.ts"],
  "tasks": {
    "//#check:repo": {
      "outputs": []
    },
    "//#typecheck:repo": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test:native": {
      "cache": false,
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "//#dev:fixture": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DESKFORM_TUNING_FILE"]
    },
    "//#dev:workshop": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DESKFORM_TUNING_FILE", "DESKFORM_WORKSHOP_PORT"]
    },
    "//#build:fixture": {
      "cache": false,
      "outputs": ["output/deskform-fixture", "output/THIRD_PARTY_NOTICES.txt"]
    },
    "//#test:integration": {
      "cache": false,
      "outputs": []
    },
    "//#test:compiled": {
      "dependsOn": ["//#build:fixture"],
      "cache": false,
      "outputs": []
    },
    "//#test:workshop": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["@deskform/runtime#pack", "@deskform/tooling#pack"]
    },
    "pack": {
      "dependsOn": ["^pack"],
      "outputs": ["dist/*.tgz"]
    },
    "//#test:consumer:fixture": {
      "dependsOn": ["@deskform/runtime#pack", "@deskform/tooling#pack"],
      "cache": false,
      "outputs": []
    }
  }
}
