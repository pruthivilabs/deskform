{
  "name": "@deskform/snippets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsrs --noEmit --fast -p tsconfig.json",
    "dev": "bun --hot src/main.tsx",
    "start": "bun src/main.tsx",
    "build": "bun build --compile --minify src/main.tsx --outfile dist/deskform-snippets",
    "test:native": "bun test tests/*.native.test.tsx",
    "test": "vp test run"
  },
  "dependencies": {
    "@deskform/runtime": "workspace:*",
    "@deskform/tokens": "workspace:*",
    "@deskform/ui": "workspace:*",
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "react": "19.2.9",
    "zod": "4.6.7"
  }
}
